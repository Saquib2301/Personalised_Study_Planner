# SmartStudy AI Environment Configuration Example

# Server Port (default 8000)
PORT=8000

# Database Connection (Defaults to local SQLite smartstudy.db)
# For MySQL: mysql+pymysql://username:password@localhost:3306/smartstudy_db
DATABASE_URL=sqlite:///./smartstudy.db

# Optional AI LLM API Keys (If omitted, high-fidelity intelligent fallback is used automatically)
OPENAI_API_KEY=
GEMINI_API_KEY=
